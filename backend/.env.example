DJANGO_DEBUG=true
DJANGO_SECRET_KEY=generate-a-long-random-secret-locally
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# Local SQLite is available only in DEBUG. Set Neon/PostgreSQL for deployment.
DATABASE_URL=
# Direct Neon URL for schema migrations; keep both URLs server-side and private.
DATABASE_DIRECT_URL=
# Optional offline snapshot path for migration tooling only.
SQLITE_DATABASE_PATH=
FRONTEND_URL=http://localhost:8081
BACKEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:8081
# Google Web application OAuth client. Register this exact backend callback:
# http://localhost:8000/api/v1/auth/google/callback/
GOOGLE_CLIENT_ID=''
GOOGLE_CLIENT_SECRET=
# Development emails go to backend/.local/emails. Configure SMTP for real delivery.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PIXEL <pixel.club@sait.ac.in>
# Local face search: provisional precision-oriented cutoff; calibrate on held-out event photos.
FACE_MATCH_THRESHOLD=0.50
FACE_SEARCH_TIMEOUT_MINUTES=120
# Setup generates a distinct value for each local computer. Never copy it between PCs.
FACE_WORKER_NODE_ID=
# Optional read-only Drive fallback when no local Drive OAuth grant is present.
GOOGLE_DRIVE_CREDENTIALS_FILE=
